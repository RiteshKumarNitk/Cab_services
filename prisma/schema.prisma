generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONTENT_MANAGER
  BOOKING_MANAGER
  FLEET_MANAGER
  DRIVER_MANAGER
  SUPPORT_EXECUTIVE
  FINANCE
  DRIVER
  CUSTOMER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

enum QuotationStatus {
  DRAFT
  SENT
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum TripStatus {
  SCHEDULED
  VEHICLE_ASSIGNED
  DRIVER_ASSIGNED
  REACHED_PICKUP
  PICKED_UP
  IN_PROGRESS
  REACHED_DESTINATION
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum VehicleType {
  SEDAN
  SUV
  HATCHBACK
  TEMPO_TRAVELLER
  LUXURY
  BUS
  MINI_BUS
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
  INACTIVE
}

enum BookingType {
  LOCAL
  OUTSTATION
  AIRPORT
  MONTHLY
  EVENT
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
  MULTI_CITY
}

enum BookingStatus {
  // CRM Pipeline (pre-booking inquiry stages)
  NEW_LEAD
  QUALIFIED
  CONTACTED
  QUOTE_PREPARING
  QUOTE_SENT
  QUOTE_ACCEPTED

  // Operations Pipeline
  BOOKING_CONFIRMED
  WAITING_ASSIGNMENT
  VEHICLE_ASSIGNED
  DRIVER_ASSIGNED
  READY_FOR_DISPATCH

  // Trip Execution
  TRIP_STARTED
  PICKUP_COMPLETED
  DROP_COMPLETED
  TRIP_COMPLETED

  // Closure
  INVOICE_GENERATED
  CLOSED
  CANCELLED

  // Legacy (for backward compat mapping)
  PENDING
  PRICE_SENT
  CONFIRMED
  VEHICLE_READY
  STARTED
  COMPLETED
}

enum DispatchStatus {
  PENDING
  VEHICLE_CHECKING
  VEHICLE_ASSIGNING
  DRIVER_ASSIGNING
  READY
  DISPATCHED
  ISSUE
}

enum PaymentMethod {
  CASH
  COMPANY
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  phone     String?
  email     String?
  website   String?
  gstNumber String?
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  users     User[]

  @@index([slug])
}

model Branch {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  address        String?
  city           String?
  state          String?
  zipCode        String?
  phone          String?
  email          String?
  managerId      String?
  manager        User?        @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users     User[]
  leads     Lead[]
  quotations Quotation[]
  bookings  Booking[]
  invoices  Invoice[]

  @@index([organizationId])
  @@index([slug])
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  passwordHash   String?
  name           String
  phone          String?
  role           Role          @default(CUSTOMER)
  profilePic     String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bookingsAsCustomer Booking[]      @relation("CustomerBookings")
  bookingsAsDriver   Booking[]      @relation("DriverBookings")
  driverStatus       DriverStatus?
  driverVehicles     Vehicle[]
  ratingsGiven       Rating[]       @relation("Rater")
  ratingsReceived    Rating[]       @relation("Rated")
  cancellations      Cancellation[]
  adminPassword      String?
  cabDriverProfile   CabDriverProfile?
  leads              Lead[]
  branchesManaged    Branch[]       @relation("BranchManager")
  auditLogs          AuditLog[]
  quotationsCreated  Quotation[]    @relation("QuotationCreatedBy")
  quotationsApproved Quotation[]    @relation("QuotationApprovedBy")
  tripAssignments    Trip[]         @relation("TripDriver")
  notifications      Notification[]
  invoices           Invoice[]
  dispatchActions    Dispatch[]     @relation("DispatchAssignee")
  driverLeaves       DriverLeave[]
  approvedLeaves     DriverLeave[] @relation("LeaveApprover")
  driverShifts       DriverShift[]
  settlements        Settlement[]
  followUps          FollowUp[]
  expensesPaid       Expense[]      @relation("ExpensePayer")
  paymentsReceived   Payment[]      @relation("PaymentReceiver")
  dispatchDriver     Dispatch[]     @relation("DispatchDriver")
  paymentCustomer    Payment[]      @relation("PaymentCustomer")
  incidents          Incident[]

  @@index([role])
  @@index([email])
  @@index([organizationId])
  @@index([branchId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, EXPORT
  entity     String   // Booking, Lead, Quotation, User, Vehicle, etc.
  entityId   String?
  metadata   String   @default("{}") // JSON payload
  ipAddress  String?
  userAgent  String?
  branchId   String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

model Lead {
  id               String        @id @default(uuid())
  leadNumber       String        @unique
  status           LeadStatus    @default(NEW)
  source           String        @default("WEBSITE") // WEBSITE, PHONE, WALKIN, REFERRAL, SOCIAL_MEDIA, OTHER

  // Customer Info
  name             String
  email            String?
  phone            String?
  alternatePhone   String?
  city             String?
  state            String?

  // Travel Requirements
  bookingType      BookingType?
  tripType         TripType?
  pickupAddress    String?
  dropAddress      String?
  pickupDate       DateTime?
  returnDate       DateTime?
  passengers       Int?
  preferredVehicle VehicleType?

  // Notes & Assignment
  notes            String?
  assignedToId     String?
  assignedTo       User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  branchId         String?
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Metadata
  leadScore            Int?           @default(0) // Current aggregated lead score (0-100)
  convertedToCustomerId String?
  convertedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  quotations       Quotation[]
  booking          Booking?
  followUps        FollowUp[]

  @@index([status])
  @@index([assignedToId])
  @@index([source])
  @@index([createdAt])
  @@index([phone])
}

model Quotation {
  id              String           @id @default(uuid())
  quotationNumber String           @unique
  leadId          String?
  lead            Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status          QuotationStatus  @default(DRAFT)
  validUntil      DateTime?
  notes           String?

  // Trip Details
  bookingType     BookingType
  tripType        TripType         @default(ONE_WAY)
  pickupAddress   String?
  dropAddress     String?
  pickupDate      DateTime?
  returnDate      DateTime?
  passengers      Int?
  vehicleType     VehicleType?

  // Pricing Breakdown
  baseFare        Float?
  perKmCharge     Float?
  totalKm         Float?
  nightCharges    Float?
  driverAllowance Float?
  parkingCharges  Float?
  tollCharges     Float?
  permitCharges   Float?
  stateTax        Float?
  discount        Float?
  gst             Float?
  totalFare       Float?

  // Approval Workflow
  createdById     String           @default("")
  createdBy       User             @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?            @relation("QuotationApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  booking         Booking?

  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

model DriverStatus {
  id        String   @id @default(uuid())
  driverId  String   @unique
  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  online    Boolean  @default(false)
  lat       Float?
  lng       Float?
  updatedAt DateTime @updatedAt

  @@index([online])
}

model CabDriverProfile {
  id               String   @id @default(uuid())
  driverId         String   @unique
  driver           User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  licenseNumber    String?
  licenseExpiry    DateTime?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  backgroundCheck  Boolean  @default(false)
  experienceYears  Int?
  languagesSpoken  String?
  emergencyContactName String?
  emergencyContactPhone String?
  driverPhoto      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Vehicle {
  id              String        @id @default(uuid())
  plateNumber     String        @unique
  model           String
  name            String        @default("")
  slug            String?       @unique
  color           String
  seats           Int
  luggage         Int           @default(2)
  ac              Boolean       @default(true)
  fuelType        String        @default("DIESEL") // PETROL, DIESEL, CNG, EV
  transmission    String        @default("MANUAL") // MANUAL, AUTO
  type            VehicleType
  status          VehicleStatus @default(AVAILABLE)
  
  shortDescription String?
  longDescription  String?
  features        String[]      @default([])
  images          String[]      @default([])
  isFeatured      Boolean       @default(false)
  displayOrder    Int           @default(0)
  seoTitle        String?
  seoDesc         String?
  
  driverId        String?
  driver          User?         @relation(fields: [driverId], references: [id])
  
  pricePerKm      Float         @default(11.0)
  minKmPerDay     Float         @default(350.0)
  nightCharge     Float         @default(200.0)
  
  insuranceExpiry DateTime?
  fitnessExpiry   DateTime?
  rcExpiry        DateTime?
  permitExpiry    DateTime?
  
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  image           String?

  bookings        Booking[]
  trips           Trip[]
  maintenance     VehicleMaintenance[]
  expenses        Expense[]
  dispatchQueue   Dispatch[]         @relation("DispatchVehicle")

  @@index([type])
  @@index([status])
  @@index([driverId])
  @@index([slug])
  @@index([displayOrder])
}

model Booking {
  id              String        @id @default(uuid())
  bookingNumber   String        @unique @default("")

  // CRM Pipeline
  leadId          String?    @unique
  lead            Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quotationId     String?    @unique
  quotation       Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  // Participants
  customerId      String
  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id])
  driverId        String?
  driver          User?         @relation("DriverBookings", fields: [driverId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?      @relation(fields: [vehicleId], references: [id])

  // Trip Request Details
  bookingType     BookingType
  tripType        TripType      @default(ONE_WAY)
  pickupAddress   String
  dropAddress     String        @default("")
  pickupDate      DateTime      @default(now())
  pickupTime      String        @default("10:00")
  returnDate      DateTime?
  returnTime      String?
  passengers      Int           @default(1)
  bags            Int           @default(0)
  preferredCategory VehicleType @default(SEDAN)
  specialInstructions String?

  pickupLat       Float?
  pickupLng       Float?
  dropLat         Float?
  dropLng         Float?
  flightNumber    String?

  // Timestamps
  scheduledTime   DateTime?
  startTime       DateTime?
  endTime         DateTime?

  // Quotation & Pricing Fields
  billableKm      Float?
  actualKm        Float?
  baseFare        Float?
  nightCharges    Float?
  driverAllowance Float?
  parkingCharges  Float?
  tollCharges     Float?
  stateTax        Float?
  permitCharges   Float?
  discount        Float?
  gst             Float?
  totalFare       Float?

  // Legacy field kept for compatibility/simpleness if needed
  fare            Float         @default(0)
  distance        Float?
  duration        Int?

  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(PENDING)

  status          BookingStatus @default(PENDING)
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rating          Rating?
  cancellations   Cancellation[]
  trip            Trip?
  invoices        Invoice[]
  incidents       Incident[]
  dispatch        Dispatch?
  payments        Payment[]
  expenses        Expense[]
  followUps       FollowUp[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([bookingType])
  @@index([createdAt])
  @@index([leadId])
  @@index([quotationId])
}

model Trip {
  id              String     @id @default(uuid())
  tripNumber      String     @unique
  bookingId       String     @unique
  booking         Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status          TripStatus @default(SCHEDULED)

  // Assignment
  vehicleId       String?
  vehicle         Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId        String?
  driver          User?      @relation("TripDriver", fields: [driverId], references: [id], onDelete: SetNull)

  // Waypoints
  pickupAddress   String?
  pickupLat       Float?
  pickupLng       Float?
  dropAddress     String?
  dropLat         Float?
  dropLng         Float?
  waypoints       String?    @default("[]") // JSON array of intermediate stops

  // Real-time tracking
  otp             String?
  startOdometer   Float?
  endOdometer     Float?
  actualDistance  Float?

  // Timestamps
  scheduledPickupTime  DateTime?
  actualPickupTime     DateTime?
  actualDropTime       DateTime?

  // Notes
  driverNotes     String?
  adminNotes      String?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  expenses        Expense[]
  settlements     Settlement[]
  incidents       Incident[]

  @@index([status])
  @@index([driverId])
  @@index([vehicleId])
  @@index([bookingId])
}

model Dispatch {
  id                  String        @id @default(uuid())
  bookingId           String        @unique
  booking             Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status              DispatchStatus @default(PENDING)

  // Vehicle checking
  vehicleCheckStatus  String?       // PENDING, IN_PROGRESS, CLEARED, ISSUE
  vehicleId           String?
  vehicle             Vehicle?      @relation("DispatchVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleCheckedById  String?
  vehicleCheckedAt    DateTime?

  // Driver assignment
  driverCheckStatus   String?       // PENDING, IN_PROGRESS, ASSIGNED, ISSUE
  driverId            String?
  driver              User?         @relation("DispatchDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driverAssignedById  String?
  driverAssignedAt    DateTime?

  notes               String?
  assignedById        String?
  assignedBy          User?         @relation("DispatchAssignee", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status])
}

model DriverLeave {
  id            String   @id @default(uuid())
  driverId      String
  driver        User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  reason        String?
  status        String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  approvedById  String?
  approvedBy    User?    @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([driverId])
  @@index([startDate, endDate])
}

model DriverShift {
  id        String   @id @default(uuid())
  driverId  String
  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0=Sunday, 1=Monday...6=Saturday
  startTime String   // "09:00"
  endTime   String   // "18:00"
  isActive  Boolean  @default(true)

  @@unique([driverId, dayOfWeek])
}

model VehicleMaintenance {
  id            String   @id @default(uuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type          String   // INSURANCE, FITNESS, PERMIT, RC, SERVICE, REPAIR, ACCIDENT, OTHER
  description   String?
  status        String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  scheduledDate DateTime
  completedDate DateTime?
  cost          Float?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
}

model FollowUp {
  id          String   @id @default(uuid())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // CALL, WHATSAPP, EMAIL, VISIT, SMS, OTHER
  notes       String?
  outcome     String?  // INTERESTED, NOT_INTERESTED, CALL_BACK, WRONG_NUMBER, CONVERTED, FOLLOW_UP
  nextAction  String?  // SEND_QUOTE, SCHEDULE_CALL, VISIT, SEND_INFO, NONE
  leadScore   Int?     // 1-10 score after this interaction
  duration    Int?     // Call duration in seconds (for CALL type)
  reminderAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([reminderAt])
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  category    String   // FUEL, MAINTENANCE, TOLL, PARKING, DRIVER_ALLOWANCE, PERMIT, OTHER
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  tripId      String?
  trip        Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  paidById    String?
  paidBy      User?    @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: SetNull)
  receiptUrl  String?
  notes       String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([vehicleId])
  @@index([date])
}

model Webhook {
  id        String   @id @default(uuid())
  url       String
  secret    String?
  events    String   @default("[]") // JSON array of event types to listen for
  isActive  Boolean  @default(true)
  lastTriggeredAt DateTime?
  failureCount Int  @default(0)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id              String        @id @default(uuid())
  paymentNumber   String        @unique
  bookingId       String?
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoice         Invoice?      @relation("PaymentInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        User?         @relation("PaymentCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  type            String        // ADVANCE, FULL, INSTALLMENT, REFUND, SECURITY_DEPOSIT
  amount          Float
  method          PaymentMethod @default(CASH)
  reference       String?
  notes           String?
  receivedById    String?
  receivedBy      User?         @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([bookingId])
  @@index([type])
}

model Settlement {
  id           String   @id @default(uuid())
  tripId       String?
  trip         Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  driverId     String
  driver       User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  totalEarnings Float   @default(0)
  advancePaid  Float    @default(0)
  expenses     Float    @default(0)
  netPayable   Float    @default(0)
  status       String   @default("PENDING") // PENDING, PAID, PARTIALLY_PAID
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([driverId])
  @@index([status])
}

model Incident {
  id        String   @id @default(uuid())
  driverId  String
  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  type      String   // ACCIDENT, BREAKDOWN, DELAY, OTHER
  description String?
  location  String?
  images    String   @default("[]") // JSON array of image URLs
  status    String   @default("REPORTED") // REPORTED, REVIEWING, RESOLVED
  createdAt DateTime @default(now())

  @@index([driverId])
}

model Notification {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    NotificationChannel @default(PUSH)
  title      String
  body       String
  data       String             @default("{}") // JSON payload
  status     NotificationStatus @default(PENDING)
  readAt     DateTime?
  sentAt     DateTime?
  createdAt  DateTime           @default(now())

  @@index([userId, status])
  @@index([createdAt])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  bookingId       String?
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        User?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          InvoiceStatus @default(DRAFT)

  // Amounts
  subtotal        Float         @default(0)
  gst             Float         @default(0)
  discount        Float         @default(0)
  total           Float         @default(0)
  paidAmount      Float         @default(0)
  dueDate         DateTime?

  // Payment
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus @default(PENDING)
  paidAt          DateTime?
  paymentReference String?

  // Metadata
  notes           String?
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payments        Payment[]    @relation("PaymentInvoice")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([bookingId])
  @@index([customerId])
  @@index([status])
  @@index([invoiceNumber])
}

model Rating {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User     @relation("Rater", fields: [raterId], references: [id])
  ratedId   String
  rated     User     @relation("Rated", fields: [ratedId], references: [id])
  score     Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())

  @@index([raterId])
  @@index([ratedId])
  @@index([bookingId])
}

model Cancellation {
  id            String   @id @default(uuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cancelledBy   User     @relation(fields: [cancelledById], references: [id])
  cancelledById String
  reason        String?
  createdAt     DateTime @default(now())

  @@index([bookingId])
}

model Pricing {
  id          String      @id @default(uuid())
  vehicleType VehicleType @unique
  baseFare    Float       @default(0)
  perKm       Float       @default(0)
  perMinute   Float       @default(0)
  minKm       Float       @default(0)
  nightCharge Float       @default(0)
  driverCharge Float      @default(0)
  waitingCharge Float     @default(0)
  eventMin    Float       @default(0)
  eventMax    Float       @default(0)
  monthlyMin  Float       @default(0)
  monthlyMax  Float       @default(0)
  updatedAt   DateTime    @updatedAt
}

model PricingPage {
  id              String @id @default(uuid())
  content         String @default("")
  parkingPolicy   String @default("")
  tollPolicy      String @default("")
  stateTaxPolicy  String @default("")
  cancellationPolicy String @default("")
  refundPolicy    String @default("")
  gstPercentage   Float  @default(5)
  seasonalPricing String @default("")
  specialOffers   String @default("")
  updatedAt       DateTime @updatedAt
}

model FleetPage {
  id      String @id @default(uuid())
  content String @default("")
  banner  String?
}

// ====== CMS MODELS ======

model WebsiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String @default("")

  @@index([key])
}

model Navigation {
  id        String           @id @default(uuid())
  name      String           @unique
  slug      String           @unique
  location  NavigationLocation @default(HEADER)
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  items NavigationItem[]

  @@index([location])
  @@index([sortOrder])
}

model NavigationItem {
  id           String      @id @default(uuid())
  navigationId String
  navigation   Navigation  @relation(fields: [navigationId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       NavigationItem? @relation("NavItemParent", fields: [parentId], references: [id])
  children     NavigationItem[] @relation("NavItemParent")
  label        String
  url          String
  icon         String?
  target       String      @default("_self")
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  cssClass     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([navigationId])
  @@index([parentId])
  @@index([sortOrder])
}

enum NavigationLocation {
  HEADER
  FOOTER
  SIDEBAR
}

model StaticPage {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  bannerImage   String?
  content       String   @default("")
  metaTitle     String?
  metaDesc      String?
  metaKeywords  String?
  ogImage       String?
  status        PageStatus @default(DRAFT)
  showInMenu    Boolean  @default(false)
  showInFooter  Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([sortOrder])
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model FAQCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  faqs FAQ[]
}

model FAQ {
  id             String      @id @default(uuid())
  question       String
  answer         String
  categoryId     String?
  category       FAQCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder      Int         @default(0)
  status         String      @default("ACTIVE")
  searchEnabled  Boolean     @default(true)
  showOnHomepage Boolean     @default(false)
  showOnFAQPage  Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([categoryId])
  @@index([sortOrder])
  @@index([status])
}

model Testimonial {
  id          String   @id @default(uuid())
  customerName String
  photo       String?
  city        String?
  vehicleUsed String?
  rating      Int      @default(5)
  review      String
  displayOrder Int     @default(0)
  status      String   @default("ACTIVE")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([displayOrder])
  @@index([status])
  @@index([featured])
}

model GalleryItem {
  id          String   @id @default(uuid())
  title       String?
  imageUrl    String
  category    String   @default("general")
  altText     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([sortOrder])
}

model BlogPost {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  category       String?
  featuredImage  String?
  gallery        String?
  shortDesc      String   @default("")
  content        String   @default("")
  author         String?
  publishedDate  DateTime?
  metaTitle      String?
  metaDesc       String?
  metaKeywords   String?
  status         String   @default("DRAFT")
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([publishedDate])
}

model ContactSubmission {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String
  department  String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model Permission {
  id        String @id @default(uuid())
  role      Role
  module    String
  canRead   Boolean @default(true)
  canCreate Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([role, module])
  @@index([role])
}

model HomepageSection {
  id        String   @id @default(uuid())
  type      String   // hero, stats, services, routes, fleet, pricing, testimonials, gallery, faq, blogs, cta, footer_cta, trusted, why_choose_us
  title     String   @default("")
  subtitle  String   @default("")
  content   String   @default("{}") // JSON blob for flexible content
  image     String?
  video     String?
  ctaText   String?
  ctaLink   String?
  ctaSecondaryText String?
  ctaSecondaryLink String?
  sortOrder Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([sortOrder])
  @@index([isEnabled])
}

model FormSubmission {
  id        String   @id @default(uuid())
  type      String   // contact, callback, trip_request, corporate, driver_registration, newsletter
  name      String
  email     String
  phone     String?
  subject   String?
  message   String?
  data      String   @default("{}") // JSON for extra fields
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([isRead])
}

model EmailTemplate {
  id      String @id @default(uuid())
  key     String @unique
  subject String @default("")
  body    String @default("")
  updatedAt DateTime @updatedAt
}

model DashboardWidget {
  id        String @id @default(uuid())
  userId    String
  widgetKey String
  enabled   Boolean @default(true)
  position  Int     @default(0)

  @@unique([userId, widgetKey])
}


